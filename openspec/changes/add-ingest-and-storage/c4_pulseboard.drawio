<mxfile host="app.diagrams.net" agent="C4 Diagram Skill" version="24.0.0" type="device">
  <diagram id="c4-container" name="C4 Container Diagram - pulseboard (add-ingest-and-storage)">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ======================================== -->
        <!-- LAYER 1: Persons (top, y ≈ 20)           -->
        <!-- ======================================== -->

        <mxCell id="person_1" value="" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;" vertex="1" parent="1">
          <mxGeometry x="460" y="20" width="40" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="person_1_label" value="&lt;b&gt;Homelab Operator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Runs and configures the pulseboard binary.&lt;/font&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="370" y="85" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- ======================================== -->
        <!-- LAYER 2: System Boundary (y ≈ 250)       -->
        <!-- ======================================== -->

        <!-- Label is top-right so the operator arrow (x=480) does not cross it -->
        <mxCell id="boundary_1" value="Pulseboard [Software System]" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;verticalAlign=top;align=right;spacingRight=10;spacingTop=10;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="320" y="250" width="880" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="container_1" value="&lt;b&gt;Pulseboard Server&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Go 1.26 single binary, &lt;i&gt;pulseboard serve&lt;/i&gt;]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Authenticates and validates metric batches, stores them, enforces 7-day retention, serves /healthz.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="320" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="db_1" value="&lt;b&gt;Metrics Database&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: SQLite file, WAL]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Stores metric types, series (canonical labels) and points. Schema v1 via user_version.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="320" width="240" height="120" as="geometry"/>
        </mxCell>

        <!-- ======================================== -->
        <!-- LAYER 3: External Systems (y ≈ 700+)     -->
        <!-- ======================================== -->

        <mxCell id="ext_1" value="&lt;b&gt;Metric Sources&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;~10 homelab apps and agents pushing gauges and counters (~1k points/sec).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#999999;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="700" width="240" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ext_2" value="&lt;b&gt;Health Checker&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Uptime monitor or process supervisor probing liveness.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#999999;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="700" width="240" height="120" as="geometry"/>
        </mxCell>

        <!-- ======================================== -->
        <!-- CONNECTIONS                               -->
        <!-- ======================================== -->

        <mxCell id="conn_1" value="Starts &lt;i&gt;pulseboard serve&lt;/i&gt;, sets config,&lt;br/&gt;stops with SIGINT/SIGTERM&lt;br/&gt;[CLI flags / env vars / POSIX signals]" style="html=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="person_1_label" target="container_1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="conn_2" value="Writes each ingest batch in one&lt;br/&gt;BEGIN IMMEDIATE transaction&lt;br/&gt;[SQL, modernc.org/sqlite]" style="html=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="container_1" target="db_1" parent="1">
          <mxGeometry y="-24" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="conn_3" value="Hourly retention: deletes expired&lt;br/&gt;points in 10k-row chunks&lt;br/&gt;[SQL, background ticker]" style="html=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;dashed=1;dashPattern=5 5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" source="container_1" target="db_1" parent="1">
          <mxGeometry y="24" relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="conn_4" value="Pushes metric batches&lt;br/&gt;POST /api/v1/ingest&lt;br/&gt;[HTTP/JSON, Bearer token]" style="html=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" source="ext_1" target="container_1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="conn_5" value="Probes liveness&lt;br/&gt;GET /healthz&lt;br/&gt;[HTTP, unauthenticated]" style="html=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" source="ext_2" target="container_1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- ======================================== -->
        <!-- LEGEND (bottom-right corner)              -->
        <!-- ======================================== -->

        <mxCell id="legend_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#CCCCCC;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="770" width="280" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1110" y="775" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_person_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1110" y="800" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="legend_person_label" value="Person" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1134" y="798" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_container_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1110" y="824" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="legend_container_label" value="Container" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1134" y="822" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_db_box" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;size=4;fillColor=#438DD5;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1110" y="848" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="legend_db_label" value="Database" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1134" y="846" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_ext_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1110" y="872" width="16" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="legend_ext_label" value="External System" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1134" y="870" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_sync_line" value="" style="endArrow=blockThin;endFill=1;strokeColor=#404040;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="808" as="sourcePoint"/>
            <mxPoint x="1290" y="808" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_sync_label" value="Synchronous" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1294" y="798" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend_async_line" value="" style="endArrow=blockThin;endFill=1;strokeColor=#404040;dashed=1;dashPattern=5 5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="832" as="sourcePoint"/>
            <mxPoint x="1290" y="832" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend_async_label" value="Asynchronous" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1294" y="822" width="80" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
